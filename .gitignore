.DS_Store
Thumbs.db

# Project specific
# 本地运行期配置（含本地目录路径等隐私信息），一律不入库。
# 注意：已被 git 跟踪过的文件需要先 `git rm --cached` 才会真正停止跟踪。
*.wallpace.json
*.wallspace.json
logs/
tests/.coverage
htmlcov/
.pytest_cache/
.pytest-tmp/

